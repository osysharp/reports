namespace Osysharp.Reports;

using Osysharp.Explore;
using Osysharp.TimeZone;

// ── the period a report covers ────────────────────────────────────────────────────────────────────────────────────────
//
// ⚑ A DAY IS THE TEAM'S DAY. "Last 30 days" is thirty calendar days on the app's clock (Settings › Time and date) — counted on
//   the calendar, not as 30 × 24 hours, so a period that crosses the change to summer time still starts at midnight.
//   A period is [From, To): From is the first instant in it, To the first instant after it.

/// The periods a person picks from. ⚠ Appended, never inserted.
public enum PeriodPreset {
  [Label("Today")] Today,
  [Label("Last 7 days")] Last7Days,
  [Label("Last 30 days")] Last30Days,
  [Label("Last 90 days")] Last90Days,
  [Label("This week")] ThisWeek,
  [Label("This month")] ThisMonth,
  [Label("Last month")] LastMonth,
  [Label("This quarter")] ThisQuarter,
  [Label("This year")] ThisYear,
  /// Two dates a person chose.
  [Label("Custom")] Custom
}

/// A period: [From, To) as instants, on the app's clock, with the bucket a trend over it is drawn in.
public class ReportPeriod {
  public PeriodPreset Preset = PeriodPreset.Last30Days;
  public DateTime From;
  public DateTime To;
  /// The first and last day of it, on the app's clock — what a person reads ("1 Sep – 30 Sep").
  public DateOnly FirstDay;
  public DateOnly LastDay;
  /// A day for a month, a week for a quarter, a month for a year — about thirty points, never three hundred.
  public TimeBucket Bucket = TimeBucket.Day;
  public Zone Zone = Zone.Of("UTC");
  public DayOfWeek WeekStart = DayOfWeek.Monday;
}

/// The period `preset` names at `now`, on the app's clock (`Osysharp.TimeZone`). For `Custom`, `first` and `last` are the
/// days chosen.
public ReportPeriod PeriodOf(PeriodPreset preset, DateTime now, AppClock clock, DateOnly? first = null, DateOnly? last = null) {
  var today = clock.DayOf(now);
  DateOnly from = today;
  DateOnly to = today;
  if (preset == PeriodPreset.Last7Days) { from = today.AddDays(-6); }
  else if (preset == PeriodPreset.Last30Days) { from = today.AddDays(-29); }
  else if (preset == PeriodPreset.Last90Days) { from = today.AddDays(-89); }
  else if (preset == PeriodPreset.ThisWeek) {
    from = clock.WeekOf(today);
  }
  else if (preset == PeriodPreset.ThisMonth) { from = new DateOnly(today.Year, today.Month, 1); }
  else if (preset == PeriodPreset.LastMonth) {
    var firstOfThis = new DateOnly(today.Year, today.Month, 1);
    from = firstOfThis.AddMonths(-1);
    to = firstOfThis.AddDays(-1);
  }
  else if (preset == PeriodPreset.ThisQuarter) { from = new DateOnly(today.Year, (today.Month - 1) / 3 * 3 + 1, 1); }
  else if (preset == PeriodPreset.ThisYear) { from = new DateOnly(today.Year, 1, 1); }
  else if (preset == PeriodPreset.Custom) {
    from = first ?? today;
    to = last ?? from;
    if (to < from) { var swap = from; from = to; to = swap; }
  }
  var days = to.DayNumber - from.DayNumber + 1;
  return new ReportPeriod {
    Preset = preset,
    FirstDay = from,
    LastDay = to,
    From = clock.StartOf(from),
    To = clock.StartOf(to.AddDays(1)),
    Bucket = days <= 1 ? TimeBucket.Hour : (days <= 45 ? TimeBucket.Day : (days <= 200 ? TimeBucket.Week : TimeBucket.Month)),
    Zone = clock.TimeZone,
    WeekStart = clock.WeekStart,
  };
}

/// The period just before `p`, as long as it — what a figure's change is measured against ("vs the 30 days before").
/// A calendar period steps back one of its own: last month against the month before it.
public ReportPeriod PreviousOf(ReportPeriod p) {
  var clock = new AppClock { TimeZone = p.Zone, WeekStart = p.WeekStart };
  if (p.Preset == PeriodPreset.ThisMonth || p.Preset == PeriodPreset.LastMonth) {
    var first = new DateOnly(p.FirstDay.Year, p.FirstDay.Month, 1).AddMonths(-1);
    var r = PeriodOf(PeriodPreset.Custom, p.From, clock, first, first.AddMonths(1).AddDays(-1));
    r.Bucket = p.Bucket;
    return r;
  }
  var length = p.LastDay.DayNumber - p.FirstDay.DayNumber + 1;
  var before = PeriodOf(PeriodPreset.Custom, p.From, clock, p.FirstDay.AddDays(-length), p.FirstDay.AddDays(-1));
  before.Bucket = p.Bucket;
  return before;
}

/// "1 Sep – 30 Sep 2026", "Today" — the period as a person reads it.
public string PeriodWords(ReportPeriod p) {
  if (p.FirstDay == p.LastDay) { return $"{p.FirstDay:d MMM yyyy}"; }
  if (p.FirstDay.Year == p.LastDay.Year) { return $"{p.FirstDay:d MMM} – {p.LastDay:d MMM yyyy}"; }
  return $"{p.FirstDay:d MMM yyyy} – {p.LastDay:d MMM yyyy}";
}

/// The filter that keeps a source's rows to `p` — its date field in [From, To).
public ExploreFilter InPeriod(string dateField, ReportPeriod p) {
  return new ExploreFilter { Field = dateField, Op = FilterOp.Between, Values = [p.From.ToString("o"), p.To.ToString("o")] };
}

/// The trend's buckets over `p` — every bucket start in order, so a day with nothing in it is a zero on the chart rather
/// than a gap the line jumps over. Computed on the calendar of the app's clock.
public List<DateTime> BucketsOf(ReportPeriod p) {
  List<DateTime> starts = [];
  var day = p.FirstDay;
  if (p.Bucket == TimeBucket.Hour) {
    for (var h = 0; h < 24; h = h + 1) { starts.Add(p.Zone.Resolve(day, new TimeOnly(h, 0))); }
    return starts;
  }
  if (p.Bucket == TimeBucket.Week) {
    var back = (((int)day.DayOfWeek - (int)p.WeekStart) % 7 + 7) % 7;
    day = day.AddDays(-back);
  }
  if (p.Bucket == TimeBucket.Month) { day = new DateOnly(day.Year, day.Month, 1); }
  while (day <= p.LastDay && starts.Count < 400) {
    starts.Add(p.Zone.Resolve(day, new TimeOnly(0, 0)));
    day = p.Bucket == TimeBucket.Day ? day.AddDays(1) : (p.Bucket == TimeBucket.Week ? day.AddDays(7) : day.AddMonths(1));
  }
  return starts;
}

/// How a bucket start is labelled on a trend's axis — "14", "Mon 6", "Sep".
public string BucketLabel(DateTime start, ReportPeriod p) {
  var local = start.InZone(p.Zone);
  if (p.Bucket == TimeBucket.Hour) { return $"{local:HH}"; }
  if (p.Bucket == TimeBucket.Month) { return $"{local:MMM}"; }
  return $"{local:d MMM}";
}
